import os
import streamlit as st
import numpy as np
import pandas as pd
from PIL import Image
import tensorflow as tf

# Page configuration
st.set_page_config(
    page_title="Skin Cancer Detection (HAM10000)",
    page_icon="🩺",
    layout="centered"
)

# HAM10000 class mapping (standard 7 classes in alphabetical order of dx)
CLASS_NAMES = {
    0: ("akiec", "Actinic Keratoses and Intraepithelial Carcinoma"),
    1: ("bcc", "Basal Cell Carcinoma"),
    2: ("bkl", "Benign Keratosis-like Lesions"),
    3: ("df", "Dermatofibroma"),
    4: ("mel", "Melanoma"),
    5: ("nv", "Melanocytic Nevi"),
    6: ("vasc", "Vascular Lesions")
}

# Resolve file paths relative to this script's directory (works on Streamlit Cloud)
BASE_DIR = os.path.dirname(os.path.abspath(__file__))
MODEL_PATH = os.path.join(BASE_DIR, "skin_cancer_model.keras")
METADATA_PATH = os.path.join(BASE_DIR, "HAM10000_metadata.csv")


@st.cache_resource
def load_trained_model():
    if not os.path.exists(MODEL_PATH):
        return None
    return tf.keras.models.load_model(MODEL_PATH)


@st.cache_data
def load_metadata():
    if not os.path.exists(METADATA_PATH):
        return None
    return pd.read_csv(METADATA_PATH)


def preprocess_image(image: Image.Image, target_size=(28, 28)):
    # Convert to RGB and resize to match HAM10000 CNN input shape
    img = image.convert("RGB").resize(target_size)
    img_array = np.asarray(img, dtype=np.float32) / 255.0
    return np.expand_dims(img_array, axis=0)


# --- UI Layout ---
st.title("🩺 Skin Lesion Classification")
st.write("Upload a dermatoscopic image to classify it across the 7 HAM10000 diagnostic categories.")

model = load_trained_model()
metadata_df = load_metadata()

if model is None:
    st.error(
        f"Model file not found at `{MODEL_PATH}`. "
        "Please export `skin_cancer_model.keras` from Colab and upload it to your GitHub repository root."
    )
    st.stop()

# Automatically detect expected input dimensions from the loaded model
input_shape = model.input_shape  # e.g., (None, 28, 28, 3)
img_height = input_shape[1] if input_shape[1] is not None else 28
img_width = input_shape[2] if input_shape[2] is not None else 28

uploaded_file = st.file_uploader("Choose a skin lesion image...", type=["jpg", "jpeg", "png"])

if uploaded_file is not None:
    image = Image.open(uploaded_file)
    st.image(image, caption="Uploaded Lesion Image", use_container_width=True)

    with st.spinner("Analyzing image..."):
        processed_img = preprocess_image(image, target_size=(img_width, img_height))
        predictions = model.predict(processed_img)[0]
        predicted_idx = int(np.argmax(predictions))
        confidence = float(predictions[predicted_idx]) * 100

    short_code, full_name = CLASS_NAMES[predicted_idx]

    st.subheader("Prediction Result")
    st.success(f"**{full_name} (`{short_code}`)** — Confidence: **{confidence:.2f}%**")

    # Show probability breakdown across all 7 classes
    prob_df = pd.DataFrame({
        "Condition": [f"{CLASS_NAMES[i][1]} ({CLASS_NAMES[i][0]})" for i in range(len(CLASS_NAMES))],
        "Probability (%)": [round(float(p) * 100, 2) for p in predictions]
    }).sort_values(by="Probability (%)", ascending=False)

    st.bar_chart(prob_df.set_index("Condition"))
    st.dataframe(prob_df, use_container_width=True, hide_index=True)

# Optional dataset overview if HAM10000_metadata.csv is present in the repo
if metadata_df is not None:
    with st.expander("View HAM10000 Dataset Summary"):
        st.write(f"Total records: **{len(metadata_df):,}**")
        st.dataframe(metadata_df.head(10), use_container_width=True)

st.caption("⚠️ Disclaimer: This tool is for educational and research purposes only and is not a medical diagnosis.")
